        <mxCell id="c1wfskSILZV_nKB9iawY-20" parent="c1wfskSILZV_nKB9iawY-19" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;spacing=3;" value="- Container orchestration&lt;div&gt;- managed identity&lt;/div&gt;&lt;div&gt;- DNS / service discovery&lt;/div&gt;&lt;div&gt;- resources: sql/document/topic/etc&lt;/div&gt;&lt;div&gt;- observability (open telemetry)&lt;/div&gt;" vertex="1">
