        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-33" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Configuration &amp;amp; Contracts" vertex="1">
          <mxGeometry height="240" width="200" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-34" parent="4xXpEnL6wiKx8CtZ7XjY-33" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;spacing=3;" value="Declaratieve human readable beschrijving van het gewenste eind resultaat in de verschillende platforms.Een unified interface.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Bv: rollen beschrijving voor het iam platform, of een yml die runtime dependencies beschrijft zoals db of queue, ADL om ardoq te augmenteren, documentatie map, ownership info, api contract, data model, ETL definition&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="200" y="30" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;" value="Development Support Platforms&lt;div&gt;- code pipelines&lt;/div&gt;&lt;div&gt;- Artefact repository&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="310" x="390" y="100" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" value="API platform, het hoeft niet graphql te zijn, maar het concept van 3 type acces paden&amp;nbsp;&lt;div&gt;query/mutation/subscription&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;En het concept van &quot;resolvers&quot; is interessant.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Je zou in GraphQL het APG landschap als een 1 generieke API kunnen exposeren, waar de contract info en bijbehorende resolver uit de verschillende software projecten komt.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Een slimme ingang geeft je de optie om slim gegevens te cachen, dat verbetert de UX, maar geeft ook een design time ontkoppeling. Vanaf de GUI kan ik m&#39;n API aanroepen functioneel bundelen en worden technische zorgen minder relevant.&amp;nbsp;&lt;br&gt;Stel, 6 micro frontends roepen verschillende generieke API&#39;s in snelle successie aan, maar onder water raken die allemaal hetzelfde endpoint op de backend. Dat absorbeert de API dat met de cache&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="730" x="300" y="670" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-37" edge="1" parent="1" source="4xXpEnL6wiKx8CtZ7XjY-28" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;dashed=1;endArrow=none;endFill=0;" target="4xXpEnL6wiKx8CtZ7XjY-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-38" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Archetype" vertex="1">
          <mxGeometry height="20" width="100" x="250" y="360" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-39" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Fitness function (Governance by Design)" vertex="1">
          <mxGeometry height="300" width="440" x="790" y="90" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-40" parent="4xXpEnL6wiKx8CtZ7XjY-39" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;spacing=3;" value="Archetypes zijn de gouden paden, het zijn business-technische concepten waarvan de architecturale acceptatie criteria gevat zijn in een fitness functie.&lt;div&gt;Archetypes geeft ons ubiquitous language.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Voorbeelden van archetypen zijn:&lt;/div&gt;&lt;div&gt;- business process microservice&lt;/div&gt;&lt;div&gt;- Portal / BFF&lt;/div&gt;&lt;div&gt;- Usecase service&lt;/div&gt;&lt;div&gt;- Custom&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;De fitness functie valideert bijvoorbeeld of verwachte declarations aanwezig zijn. Bij het custom archetype is dit een minimale verwachting, maar komt de requirement erbij dat er een DHT consent is vastgelegd in SNOW. Custom is bedoeld om emerging-archetypen of one-off&#39;s te ondersteunen, dus een niet gebaand pad. Dit soort componenten ontstaan meestal als experiment (lokaal, geen deployment nodig), en evolueren naar een MVP, middels OODA loop.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Een ADR proces met DHT als stakeholders zou moeten volstaan om soepel naar MVP consent te komen. De eerste ADR van het component legt uit waarom een custom nodig is, en geen archetype gebruikt kan worden.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="440" y="30" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-41" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;align=left;verticalAlign=top;" value="Environment" vertex="1">
          <mxGeometry height="160" width="280" x="1100" y="670" as="geometry" />
        </mxCell>
        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;align=left;verticalAlign=top;" value="Container orkestrator" vertex="1">
          <mxGeometry height="130" width="240" x="1170" y="770" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
