        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-32" parent="4xXpEnL6wiKx8CtZ7XjY-31" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;spacing=3;" value="- TestData management&lt;br&gt;&lt;div&gt;- test automation support&lt;/div&gt;&lt;div&gt;- test data analyses support&lt;/div&gt;&lt;div&gt;- evidence registration&lt;/div&gt;" vertex="1">
