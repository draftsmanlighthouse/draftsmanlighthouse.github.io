        <mxCell id="4xXpEnL6wiKx8CtZ7XjY-30" parent="4xXpEnL6wiKx8CtZ7XjY-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;spacing=3;" value="- Onthology / CDM&lt;br&gt;&lt;div&gt;- Warehouse ETL&lt;/div&gt;&lt;div&gt;- AI support&lt;/div&gt;" vertex="1">
